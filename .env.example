# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Filled in automatically by `npm run stripe:setup` (see scripts/create-stripe-products.ts),
# or paste it in yourself after creating the Full OS price manually.
STRIPE_PRICE_FULL_OS=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="BrickOS <hello@thecoopdao.xyz>"

# Random secret string — Vercel sends this as a Bearer token to your cron
# routes automatically once both this var and vercel.json's crons exist.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://brickos.thecoopdao.xyz
